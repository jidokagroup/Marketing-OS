{
  "manifest_version": 3,
  "name": "JIDOKA Marketing OS Scanner",
  "description": "Connects JIDOKA Marketing OS to logged-in Chrome pages for competitor and influencer trend scans.",
  "version": "0.1.0",
  "action": {
    "default_title": "JIDOKA Scanner",
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "https://jidokagroup.com/*",
    "https://www.jidokagroup.com/*",
    "https://jidoka-marketing-os.netlify.app/*",
    "https://instagram.com/*",
    "https://www.instagram.com/*",
    "https://facebook.com/*",
    "https://www.facebook.com/*",
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://linkedin.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://jidokagroup.com/*",
        "https://www.jidokagroup.com/*",
        "https://jidoka-marketing-os.netlify.app/*"
      ],
      "js": ["src/marketing-os-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://instagram.com/*",
        "https://www.instagram.com/*",
        "https://facebook.com/*",
        "https://www.facebook.com/*",
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://youtu.be/*",
        "https://tiktok.com/*",
        "https://www.tiktok.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://linkedin.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["src/social-page-scanner.js"],
      "run_at": "document_idle"
    }
  ]
}
